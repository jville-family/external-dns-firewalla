# Shared HMAC secret (must match the Kubernetes proxy Secret)
HMAC_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed DNS suffixes (dot-boundary matching)
ALLOWED_DOMAINS=app.lan,k8s.local

# Bind address. Default 127.0.0.1 is loopback-only —
# set to the Firewalla LAN IP (or 0.0.0.0) so the cluster can reach it.
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=10053

# warn keeps steady-state journal silent
LOG_LEVEL=warn

# Optional overrides
# STATE_DIR=/home/pi/.firewalla/k8s-external-dns
# DNSMASQ_DIR=/home/pi/.firewalla/config/dnsmasq_local
# CONF_NAME=k8s-external-dns.conf
# RELOAD_MODE=restart
